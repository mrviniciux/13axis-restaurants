MUDRA_DB_PASSWORD="replace-with-a-local-random-password"
# Local (Docker): runtime e migrações usam a mesma URL.
DATABASE_URL="postgresql://13axis:replace-with-a-local-random-password@127.0.0.1:55432/13axis?schema=public"
DIRECT_DATABASE_URL="postgresql://13axis:replace-with-a-local-random-password@127.0.0.1:55432/13axis?schema=public"
# Prisma Postgres (db.prisma.io): pooled no runtime (Vercel), direta nas migrações.
# DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# DIRECT_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
REALTIME_JWT_SECRET="replace-with-at-least-32-random-bytes"
REALTIME_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
SOCKET_IO_PORT=3001
NODE_ENV=development
